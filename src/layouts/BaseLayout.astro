---
import '../styles/global.css';

const {
  title = 'Bolan Xu',
  description = 'Things I build, ideas I have, and what I am learning along the way.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">

        <a class="brand" href="/">
          Bolan Xu
        </a>

        <nav class="nav-links">
          <a href="/projects">Projects</a>
          <a href="/blog">Writing</a>
          <a href="/about">About</a>
        </nav>

      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="container footer">
      <span>Bolan Xu</span>

      <span>
        © {new Date().getFullYear()} Bolan Xu
      </span>
    </footer>
  </body>
</html>