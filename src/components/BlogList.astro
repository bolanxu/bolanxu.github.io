---
interface Post {
  id: string;
  data: {
    date: Date;
    title: string;
    description?: string;
  };
}

interface Props {
  posts: Post[];
}

const { posts } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Dates are stored at UTC midnight, so format in UTC to avoid showing the day before.
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a class="post-link" href={`${base}/blog/${post.id}/`}>
        <time class="post-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>

        <span class="post-body">
          <span class="post-title">{post.data.title}</span>

          {post.data.description && (
            <span class="post-description">{post.data.description}</span>
          )}
        </span>

        <span class="post-arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>


<style>
  .post-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .post-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .post-link {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: 1.4rem 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .post-link:hover {
    color: var(--color-text);
  }

  .post-date {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 160ms ease;
  }

  .post-description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .post-arrow {
    color: var(--color-text-muted);
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .post-link:hover .post-title,
  .post-link:focus-visible .post-title {
    color: var(--color-accent);
  }

  .post-link:hover .post-arrow,
  .post-link:focus-visible .post-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .post-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .post-link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-1) var(--space-3);
    }

    .post-date {
      grid-column: 1 / -1;
    }

    .post-title {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-title,
    .post-arrow {
      transition: none;
    }

    .post-link:hover .post-arrow,
    .post-link:focus-visible .post-arrow {
      transform: none;
    }
  }
</style>