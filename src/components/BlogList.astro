---
const { posts } = Astro.props;
---

<div class="log-list">

  {posts.map((post) => (

    <a
      class="log-item"
      href={`/blog/${post.id}/`}
    >

      <span class="log-date">
        {post.data.date.toLocaleDateString(
          'en-US',
          {
            month: 'short',
            day: '2-digit',
            year: 'numeric',
          }
        )}
      </span>


      <span>

        <span class="log-title">
          {post.data.title}
        </span>

        <br />

        <span class="muted">
          {post.data.description}
        </span>

      </span>


      <span class="log-arrow">
        →
      </span>

    </a>

  ))}

</div>