---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import BlogList from "../../components/BlogList.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Writing | Reserved Bits"
  description="Things I'm thinking about, learning, building, and trying to understand."
>
  <PageHead
    eyebrow="Writing"
    title="Writing."
    intro="Thoughts about technology, AI, building things, learning, and whatever has been taking up space in my head lately."
  />

  {posts.length > 0 ? (
    <BlogList posts={posts} />
  ) : (
    <p class="empty">Nothing here yet. The first posts are on their way.</p>
  )}
</BaseLayout>


<style>
  .empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }
</style>