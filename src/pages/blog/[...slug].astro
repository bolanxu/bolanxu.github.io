---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleHead from "../../components/ArticleHead.astro";
import ContentEnhancements from "../../components/ContentEnhancements.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Dates are stored at UTC midnight, so format in UTC to avoid showing the day before.
const dateLabel = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={`${post.data.title} | Reserved Bits`}
  description={post.data.description}
>
  <article>
    <ArticleHead
      eyebrow={dateLabel}
      title={post.data.title}
      intro={post.data.description}
      tags={post.data.tags ?? []}
    />

    {post.data.image && (
      <img
        class="post-hero-image"
        src={post.data.image}
        alt={post.data.title}
      />
    )}

    <div class="prose">
      <Content />
    </div>
  </article>

  <p class="back-link">
    <a href={`${base}/blog/`}>← All writing</a>
  </p>

  <ContentEnhancements />
</BaseLayout>


<style>
  .post-hero-image {
    width: 100%;
    max-height: 460px;
    margin-bottom: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    object-fit: cover;
  }

  .back-link {
    margin: var(--space-7) 0 0;
    font-size: 0.95rem;
  }

  .back-link a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back-link a:hover {
    color: var(--color-accent);
  }
</style>