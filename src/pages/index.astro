---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogList from '../components/BlogList.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter(p => p.data.featured)
  .sort((a, b) =>
    a.data.number.localeCompare(b.data.number)
  );

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort(
    (a, b) =>
      b.data.date.valueOf() -
      a.data.date.valueOf()
  )
  .slice(0, 4);

const benchProjects = (await getCollection('projects'))
  .filter(
    p =>
      p.data.status === 'active' ||
      p.data.status === 'experiment'
  )
  .sort((a, b) => {
    const dateA = a.data.updated ?? a.data.date;
    const dateB = b.data.updated ?? b.data.date;

    return dateB.valueOf() - dateA.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout>

  <main class="home">

    <!-- HERO -->

    <section class="hero container">

      <div class="hero-content">

        <div class="eyebrow">
          BUILDING · THINKING · LEARNING
        </div>

        <h1>
          Hi, I'm<br />
          Bolan.
        </h1>

        <p class="hero-copy">
          I like building things, taking them apart, and thinking
          about how technology changes the way we work and live.
          This is where I write about what I'm making, what I'm
          learning, and whatever I'm currently thinking about.
        </p>

        <div class="actions">

          <a
            class="button primary"
            href="/blog"
          >
            Read my writing →
          </a>

          <a
            class="button"
            href="/projects"
          >
            See my projects
          </a>

        </div>

      </div>


      <aside class="profile">

        <div class="profile-image-wrap">

          <img
            class="profile-image"
            src="/assets/images/bolan.jpg"
            alt="Bolan Xu"
          />

        </div>

        <div class="profile-info">

          <div>
            <span class="eyebrow">
              High school senior
            </span>

            <h3>
              Bolan Xu
            </h3>
          </div>

          <span class="profile-mark mono">
            Bowling Green, OH
          </span>

        </div>

      </aside>

    </section>


    <!-- CURRENTLY -->

    <section class="bench-section container">

      <div class="bench">

        <div class="bench-title">

          <span class="eyebrow">
            Currently
          </span>

          <span class="mono muted">
            NOW
          </span>

        </div>

        <div class="bench-projects">

          {benchProjects.map((project) => (

            <a
              class="bench-project"
              href={`/projects/${project.id}`}
            >

              <span class="status">
                {project.data.status}
              </span>

              <h3>
                {project.data.title}
              </h3>

              <p class="muted">
                {project.data.description}
              </p>

            </a>

          ))}

        </div>

      </div>

    </section>


    <!-- WRITING -->

    <section class="section">

      <div class="container">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              01 / WRITING
            </div>

            <h2>
              Things I'm thinking about.
            </h2>

          </div>

          <a href="/blog">
            ALL WRITING →
          </a>

        </div>

        <BlogList posts={posts} />

      </div>

    </section>


    <!-- PROJECTS -->

    <section class="section">

      <div class="container">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              02 / PROJECTS
            </div>

            <h2>
              Things I've built.
            </h2>

          </div>

          <a href="/projects">
            VIEW PROJECTS →
          </a>

        </div>

        <div class="project-grid">

          {projects.map(project => (
            <ProjectCard project={project} />
          ))}

        </div>

      </div>

    </section>

  </main>

</BaseLayout>