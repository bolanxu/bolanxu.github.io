---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogList from '../components/BlogList.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.number.localeCompare(b.data.number));

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

/*
 * Automatically populate "ON THE BENCH"
 *
 * Active projects = things currently being built
 * Experiment projects = things currently being explored
 */
const benchProjects = (await getCollection('projects'))
  .filter(p =>
    p.data.status === 'active' ||
    p.data.status === 'experiment'
  )
  .sort((a, b) => {
    const dateA = a.data.updated ?? a.data.date;
    const dateB = b.data.updated ?? b.data.date;

    return dateB.valueOf() - dateA.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout>

  <main class="home">

    <!-- =========================================
         HERO
         ========================================= -->

    <section class="hero">

      <div class="hero-content">

        <div class="eyebrow">
          ELECTRONICS · ROBOTICS · SOFTWARE · MAKING
        </div>

        <h1>
          My Portfolio
        </h1>

        <p class="hero-copy">
          I'm Bolan. I like figuring out how things work, then building my own
          version. This is my website documenting what I'm making, breaking,
          and learning.
        </p>

        <div class="actions">

          <a class="button primary" href="/projects">
            EXPLORE PROJECTS →
          </a>

          <a class="button" href="/blog">
            READ THE LAB LOG
          </a>

        </div>

      </div>


      <!-- =========================================
           PROFILE PHOTO
           ========================================= -->

      <aside class="profile">

        <div class="profile-image-wrap">

          <img
            class="profile-image"
            src="/assets/images/bolan.jpg"
            alt="Bolan Xu"
          />

          <div class="profile-corner top-left"></div>
          <div class="profile-corner top-right"></div>
          <div class="profile-corner bottom-left"></div>
          <div class="profile-corner bottom-right"></div>

        </div>

        <div class="profile-info">

          <div>
            <span class="eyebrow">
              HIGH SCHOOL SENIOR
            </span>

            <h3>
              BOLAN XU
            </h3>
          </div>

          <span class="profile-mark mono">
            BOWLING GREEN · OH
          </span>

        </div>

      </aside>

    </section>


    <!-- =========================================
         ON THE BENCH
         ========================================= -->

    <section class="bench-section">

      <div class="bench">

        <div class="bench-title">

          <span class="eyebrow">
            ON THE BENCH
          </span>

          <span class="mono muted">
            NOW
          </span>

        </div>


        <div class="bench-projects">

          {benchProjects.map((project) => (

            <a
              class="bench-project"
              href={`/projects/${project.id}`}
            >

              <span class="status">
                {project.data.status}
              </span>

              <h3>
                {project.data.title}
              </h3>

              <p class="muted">
                {project.data.description}
              </p>

            </a>

          ))}

        </div>

      </div>

    </section>


    <!-- =========================================
         SELECTED PROJECTS
         ========================================= -->

    <section class="section">

      <div class="section-head">

        <div>

          <div class="eyebrow">
            01 / WORK
          </div>

          <h2>
            Selected builds.
          </h2>

        </div>

        <a href="/projects">
          VIEW ARCHIVE →
        </a>

      </div>


      <div class="project-grid">

        {projects.map(project => (
          <ProjectCard project={project} />
        ))}

      </div>

    </section>


    <!-- =========================================
         LAB LOG
         ========================================= -->

    <section class="section">

      <div class="section-head">

        <div>

          <div class="eyebrow">
            02 / NOTES
          </div>

          <h2>
            Lab log.
          </h2>

        </div>

        <a href="/blog">
          ALL ENTRIES →
        </a>

      </div>


      <BlogList posts={posts} />

    </section>

  </main>


  <style>

    /* =========================================
       HOME
       ========================================= */

    .home {
      padding-inline: 32px;
    }


    /* =========================================
       HERO
       ========================================= */

    .hero {
      grid-template-columns: 1.25fr 0.75fr;

      align-items: center;

      gap: 60px;
    }

    .hero-content {
      min-width: 0;
    }


    /* =========================================
       PROFILE
       ========================================= */

    .profile {
      width: min(100%, 300px);

      justify-self: end;
    }

    .profile-image-wrap {
      position: relative;

      border: 1px solid var(--line);

      background: var(--panel);

      padding: 10px;

      box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.25);
    }

    .profile-image {
      width: 100%;

      aspect-ratio: 4 / 5;

      display: block;

      object-fit: cover;

      filter:
        saturate(0.82)
        contrast(1.03);

      border: 1px solid var(--line);
    }


    /* Technical corner marks */

    .profile-corner {
      position: absolute;

      width: 18px;
      height: 18px;

      pointer-events: none;
    }

    .profile-corner::before,
    .profile-corner::after {
      content: "";

      position: absolute;

      background: var(--accent);
    }

    .profile-corner::before {
      width: 18px;
      height: 1px;
    }

    .profile-corner::after {
      width: 1px;
      height: 18px;
    }

    .top-left {
      top: 4px;
      left: 4px;
    }

    .top-right {
      top: 4px;
      right: 4px;

      transform: rotate(90deg);
    }

    .bottom-left {
      bottom: 4px;
      left: 4px;

      transform: rotate(-90deg);
    }

    .bottom-right {
      bottom: 4px;
      right: 4px;

      transform: rotate(180deg);
    }


    /* Photo information */

    .profile-info {
      display: flex;

      justify-content: space-between;
      align-items: flex-end;

      padding-top: 14px;
    }

    .profile-info h3 {
      margin-top: 5px;
      margin-bottom: 0;

      font-size: 1.15rem;

      letter-spacing: -0.02em;
    }

    .profile-mark {
      font-size: 0.68rem;

      color: var(--muted);
    }


    

  </style>

</BaseLayout>