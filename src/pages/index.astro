---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogList from "../components/BlogList.astro";
import { getCollection } from "astro:content";

// Keeps links working whether the site lives at the root or under a repo name.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const allProjects = await getCollection("projects");

const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.number.localeCompare(b.data.number));

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title="Reserved Bits"
  description="Reserved Bits is a personal blog about making things, questioning assumptions, and figuring out how the world works."
>
  <div class="home">

    <!-- INTRO -->

    <section class="intro">

      <div class="intro-main">

        <p class="eyebrow">A personal blog</p>

        <h1>
          Why does it have to<br />
          <span class="accent">work that way?</span>
        </h1>

        <div class="intro-content">
          <p class="intro-copy">
            A personal blog about making things, taking them apart,
            and asking why they work the way they do. Expect projects,
            experiments, half-formed ideas, and the occasional rabbit hole.
          </p>

          <div class="intro-actions">
            <a class="intro-action" href={`${base}/blog/`}>
              <span>Start with the writing</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>

            <a class="intro-action" href={`${base}/projects/`}>
              <span>Browse the projects</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="name-note">
          <span class="name-note-mark" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </span>

          <p>
            Why “Reserved Bits”? In the manual for a computer chip, a few
            settings are marked “reserved,” which is a polite way of saying
            “please don’t touch.” This blog is named for the people who
            wonder what happens if you do.
          </p>
        </div>

      </div>

      <div class="intro-image">
        <img
          src={`${base}/assets/images/home/terminus.jpg`}
          alt="A homemade terminal-style phone on a workbench"
        />
      </div>

    </section>


    <!-- WRITING -->

    <section class="home-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Writing</p>
          <h2>What I’ve been writing.</h2>
        </div>

        <a class="section-link" href={`${base}/blog/`}>
          All writing
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      {posts.length > 0 ? (
        <BlogList posts={posts} />
      ) : (
        <p class="empty">Nothing here yet. The first posts are on their way.</p>
      )}
    </section>


    <!-- PROJECTS -->

    <section class="home-section projects-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Projects</p>
          <h2>Things I’ve made.</h2>
        </div>

        <a class="section-link" href={`${base}/projects/`}>
          All projects
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      {featuredProjects.length > 0 ? (
        <div class="project-grid">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="empty">The first project write-ups are coming soon.</p>
      )}
    </section>

  </div>
</BaseLayout>


<style>
  .home {
    width: min(100%, 1120px);
    margin: 0 auto;
  }


  /* INTRO */

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    padding: 4.5rem 0 6rem;
  }

  .intro-main {
    min-width: 0;
  }

  .intro .eyebrow {
    margin-bottom: 1.25rem;
  }

  .intro h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.25rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .intro h1 .accent {
    color: var(--color-accent);
  }

  .intro-content {
    max-width: 34rem;
    margin-top: 2rem;
  }

  .intro-copy {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .intro-action {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: transparent;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .intro-action:hover {
    border-color: var(--color-accent);
    background: var(--color-surface);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  .intro-action .arrow {
    color: var(--color-accent);
    font-size: 1.05rem;
  }


  /* INTRO IMAGE */

  .intro-image {
    width: 100%;
    transform: translateY(-60px);
  }

  .intro-image img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    object-fit: cover;
  }


  /* NAME NOTE */

  .name-note {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    max-width: 34rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .name-note p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .name-note-mark {
    display: grid;
    grid-template-columns: repeat(8, 5px);
    gap: 2px;
    flex-shrink: 0;
    padding-top: 0.45rem;
  }

  .name-note-mark span {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--color-border);
  }

  .name-note-mark span:nth-child(5) {
    background: var(--color-accent);
  }


  /* SECTIONS */

  .home-section {
    margin-bottom: 6rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .section-heading .eyebrow {
    margin-bottom: 0.5rem;
  }

  .section-heading h2 {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    text-transform: uppercase;
  }

  .section-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .section-link span {
    color: var(--color-accent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .projects-section {
    padding-bottom: 2rem;
  }

  .empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }


  /* KEYBOARD FOCUS */

  .intro-action:focus-visible,
  .section-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }


  /* RESPONSIVE */

  @media (max-width: 600px) {
  .intro {
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 3rem 0 4.5rem;
  }

  .intro-image {
    max-width: 100%;
  }

  .project-grid {
    grid-template-columns: 1fr;
  }
}

  @media (max-width: 600px) {
    .intro h1 {
      font-size: clamp(2.4rem, 11vw, 3.25rem);
    }

    .intro-copy {
      font-size: 1.05rem;
    }

    .intro-action {
      justify-content: space-between;
      width: 100%;
    }

    .name-note {
      margin-top: 3rem;
    }

    .home-section {
      margin-bottom: 4.5rem;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-action {
      transition: none;
    }
  }
</style>