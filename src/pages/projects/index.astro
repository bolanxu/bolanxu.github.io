---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.number.localeCompare(b.data.number)
);
---

<BaseLayout
  title="Projects | Reserved Bits"
  description="Things I've built, experimented with, and learned from."
>
  <div class="page-wide">
    <PageHead
      eyebrow="Projects"
      title="Things I’ve made."
      intro="Electronics, software, robots, experiments, and the occasional overly complicated solution to a very simple problem."
    />

    {projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    ) : (
      <p class="empty">The first project write-ups are coming soon.</p>
    )}
  </div>
</BaseLayout>


<style>
  .page-wide {
    width: 100%;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  @media (max-width: 760px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>