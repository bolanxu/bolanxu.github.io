---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleHead from "../../components/ArticleHead.astro";
import BlogList from "../../components/BlogList.astro";
import ContentEnhancements from "../../components/ContentEnhancements.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Blog posts that belong to this project, newest first.
const relatedPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && post.data.project === project.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tags = [project.data.category, ...(project.data.technologies ?? [])].filter(
  Boolean
);
---

<BaseLayout
  title={`${project.data.title} | Reserved Bits`}
  description={project.data.description}
>
  <article>
    <ArticleHead
      eyebrow={`Project ${project.data.number}`}
      title={project.data.title}
      intro={project.data.description}
      status={project.data.status}
      tags={tags}
    />

    <div class="prose">
      <Content />
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="project-log">
      <p class="eyebrow">Project log</p>
      <h2>Build notes.</h2>

      <BlogList posts={relatedPosts} />
    </section>
  )}

  <p class="back-link">
    <a href={`${base}/projects/`}>← All projects</a>
  </p>

  <ContentEnhancements />
</BaseLayout>


<style>
  .project-log {
    margin-top: var(--space-8);
  }

  .project-log .eyebrow {
    margin-bottom: var(--space-2);
  }

  .project-log h2 {
    margin-bottom: var(--space-5);
  }

  .back-link {
    margin: var(--space-7) 0 0;
    font-size: 0.95rem;
  }

  .back-link a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back-link a:hover {
    color: var(--color-accent);
  }
</style>